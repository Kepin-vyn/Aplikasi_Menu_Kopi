<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header BrewList -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BrewList"
        android:padding="20dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#3E2723"
        android:textColor="#FFFFFF" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cari menu kopi..."
        android:padding="12dp"
        android:layout_margin="8dp"
        android:background="@android:drawable/editbox_background_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSortAZ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sort A-Z"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#5D4037" />

        <Button
            android:id="@+id/btnSortZA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sort Z-A"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#5D4037" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="#757575" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Menggunakan GridView 2 kolom untuk Portrait juga -->
        <GridView
            android:id="@+id/gridViewCoffee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:padding="8dp"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="8dp"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Menu tidak ditemukan"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
